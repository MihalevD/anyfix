# AnyFix Frontend – environment variables
# Local: copy as `.env.local`. Vercel: paste each line into Project → Settings → Environment Variables.

# ─── REQUIRED ────────────────────────────────────────────
# URL of your deployed backend (Railway / Render). No trailing slash.
NEXT_PUBLIC_API_URL="https://your-backend.up.railway.app"

# Public URL of this frontend (used in metadata / social cards).
NEXT_PUBLIC_APP_URL="https://your-frontend.vercel.app"

# ─── OPTIONAL ────────────────────────────────────────────
# If unset, Stripe payment UI will not load.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# If unset, chat & push notifications are silently disabled.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# If unset, the map on master listings is hidden.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
